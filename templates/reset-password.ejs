<div style="
    max-width: 500px;
    margin: auto;
    font-family: 'Segoe UI', sans-serif;
    background-color: #f9f9f9;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 30px;
  ">
    <div style="text-align: center; margin-bottom: 20px">
        <h1 style="color: #4a90e2; margin: 0">Reset Your Password</h1>
    </div>

    <p style="font-size: 16px; color: #333">Hi <%= username %>,</p>

    <p style="font-size: 16px; color: #333">
        We received a request to reset your password. Click the button below to set a new password:
    </p>

    <div style="text-align: center; margin: 30px 0">
        <a href="<%= resetLink %>" style="
        display: inline-block;
        background-color: #4a90e2;
        color: #fff;
        font-size: 16px;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: bold;
      " target="_blank">
            Reset Password
        </a>
    </div>

    <p style="font-size: 14px; color: #555">
        This link will expire in 30 minutes. If you didn’t request this, you can safely ignore this email.
    </p>

    <p style="font-size: 14px; color: #888; text-align: center; margin-top: 40px">
        — The HR Manager Team
    </p>
</div>