<div style="
    max-width: 500px;
    margin: auto;
    font-family: 'Segoe UI', sans-serif;
    background-color: #f9f9f9;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 30px;
  ">
  <div style="text-align: center; margin-bottom: 20px">
    <h1 style="color: #4a90e2; margin: 0">Verify Your Email</h1>
  </div>

  <p style="font-size: 16px; color: #333">Hi <%= username %>,</p>

  <p style="font-size: 16px; color: #333">
    Please use the following One-Time Password (OTP) to complete your action:
  </p>

  <div style="text-align: center; margin: 30px 0">
    <span style="
        display: inline-block;
        background-color: #4a90e2;
        color: #fff;
        font-size: 24px;
        letter-spacing: 4px;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: bold;
      ">
      <%= otp %>
    </span>
  </div>

  <p style="font-size: 14px; color: #555">
    This code will expire in 10 minutes. If you didn’t request this, you can
    safely ignore this email.
  </p>

  <p style="font-size: 14px; color: #888; text-align: center; margin-top: 40px">
    — The HR Manager Team
  </p>
</div>